# PostGIS connection
HOMEIQ_DB_HOST=localhost
HOMEIQ_DB_PORT=5432
HOMEIQ_DB_NAME=homeiq
HOMEIQ_DB_USER=homeiq
HOMEIQ_DB_PASSWORD=homeiq

# Socrata (Seattle SDCI permits). No key needed for low request volume,
# but an app token raises the throttling ceiling if ingestion gets rerun a lot.
SOCRATA_APP_TOKEN=

# Where the KC Assessor bulk extracts live on disk. P0 reuses files already
# downloaded for a prior project (see README) rather than re-fetching ~1.4GB.
KC_ASSESSOR_RAW_DIR=/Users/robertgiometti/Code/home_iq/causal_analysis/data
